# Local defaults only. Do not put a real password in Git.
# Copy to .env and override these values outside the repository for any shared environment.

DB_HOST=localhost
DB_PORT=5432
DB_NAME=arabic_reference
DB_USERNAME=arabic_reference
DB_PASSWORD=local-dev-only

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=local-dev-only

SERVER_PORT=8080
# Production (SPRING_PROFILES_ACTIVE=prod) listens on PORT when a host sets it, and requires sslmode via DB_SSLMODE (default require).
# DB_SSLMODE=require
DB_POOL_SIZE=20
FRONTEND_URL=http://localhost:3000
# Comma-separated proxy IPs. Empty means X-Forwarded-For is ignored.
TRUSTED_PROXIES=
# Send HSTS only on the real HTTPS deployment. Leave false for local HTTP.
ENABLE_HSTS=false
# Leave unset locally. Set to prod only with non-local secrets; the process refuses to start otherwise.
# SPRING_PROFILES_ACTIVE=prod
# SITE_URL is the canonical origin. NEXT_PUBLIC_SITE_URL is used when SITE_URL is empty;
# Vercel production deployments can fall back to VERCEL_PROJECT_PRODUCTION_URL.
# Indexing stays off unless SEO_INDEXING_ENABLED=true.
SITE_URL=
SEO_INDEXING_ENABLED=false
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8080

# Optional search-engine verification. No tag is rendered when this is empty.
GOOGLE_SITE_VERIFICATION=

# Local signing key only. Generate a different 32+ byte secret outside local development.
ADMIN_JWT_SECRET=local-dev-only-admin-jwt-secret-key-32b
ADMIN_PASSWORD_RATE_LIMIT=10

# Leave all four blank to skip owner creation. Set all four to create the first platform owner once.
# There is no default owner password.
BOOTSTRAP_OWNER_USERNAME=
BOOTSTRAP_OWNER_EMAIL=
BOOTSTRAP_OWNER_DISPLAY_NAME=
BOOTSTRAP_OWNER_PASSWORD=

# Linguistic assistant. Leave disabled unless a provider key is set outside Git.
AI_ENABLED=false
AI_PROVIDER=none
AI_MODEL=
AI_API_KEY=

# Anonymous quiz attempts. The token lifetime is clamped between 30 and 120 minutes.
LEARNING_ATTEMPT_TTL=60m
LEARNING_RATE_LIMIT=20
